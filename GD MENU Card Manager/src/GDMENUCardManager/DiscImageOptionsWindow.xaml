<Window x:Class="GDMENUCardManager.DiscImageOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GDMENUCardManager.Converter"
        mc:Ignorable="d"
        Title="Disc Image Options" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <conv:BoolToVisibleOrCollapsedConverter x:Key="BoolToVisibleOrCollapsed"/>
        <conv:SubOptionVisualConverter x:Key="SubOptionVisual"/>
        <conv:BoolOrMultiValueConverter x:Key="BoolOr"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Stretch">

            <!-- GDI Shrink Card -->
            <GroupBox Margin="0 0 0 10">
                <GroupBox.Header>
                    <TextBlock Text="GDI Shrink" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel Margin="8">
                    <TextBlock Text="Games use less space on SD card, not recommended" TextWrapping="Wrap"
                               Foreground="Gray" FontSize="11" Margin="0 0 0 10"/>
                    <CheckBox x:Name="ChkEnableGDIShrink" IsChecked="{Binding EnableGDIShrink, Mode=TwoWay}"
                              ToolTip="Shrink GDI images as games are added to the list">
                        <TextBlock Text="Apply to newly added games"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding EnableGDIShrinkExisting, Mode=TwoWay}" Margin="0 5 0 0"
                              ToolTip="Shrink GDI games already on the SD card">
                        <TextBlock Text="Apply to existing games"/>
                    </CheckBox>
                    <Separator Margin="0 8"/>
                    <CheckBox IsEnabled="{Binding IsChecked, ElementName=ChkEnableGDIShrink}"
                              ToolTip="Also apply GDI shrink to games added from compressed archives">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource SubOptionVisual}">
                                <Binding Path="EnableGDIShrinkCompressed" Mode="TwoWay"/>
                                <Binding Path="EnableGDIShrink" Mode="OneWay"/>
                            </MultiBinding>
                        </CheckBox.IsChecked>
                        <TextBlock Text="Also shrink compressed" FontSize="11"/>
                    </CheckBox>
                    <CheckBox Margin="0 3 0 0"
                              Visibility="{Binding HaveGDIShrinkBlacklist, Mode=OneWay, Converter={StaticResource BoolToVisibleOrCollapsed}}"
                              ToolTip="Skip games known to have problems when shrunk">
                        <CheckBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource BoolOr}">
                                <Binding Path="EnableGDIShrink" Mode="OneWay"/>
                                <Binding Path="EnableGDIShrinkExisting" Mode="OneWay"/>
                            </MultiBinding>
                        </CheckBox.IsEnabled>
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource SubOptionVisual}">
                                <Binding Path="EnableGDIShrinkBlackList" Mode="TwoWay"/>
                                <Binding Path="EnableGDIShrink" Mode="OneWay"/>
                                <Binding Path="EnableGDIShrinkExisting" Mode="OneWay"/>
                            </MultiBinding>
                        </CheckBox.IsChecked>
                        <TextBlock Text="Use blacklist (recommended)" FontSize="11"/>
                    </CheckBox>
                </StackPanel>
            </GroupBox>

            <!-- VGA Patch Card -->
            <GroupBox Margin="0 0 0 10">
                <GroupBox.Header>
                    <TextBlock Text="VGA Patch" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel Margin="8">
                    <TextBlock Text="Only needed if booting games after &quot;Exit to BIOS&quot; from openMenu" TextWrapping="Wrap"
                               Foreground="Gray" FontSize="11" Margin="0 0 0 10"/>
                    <CheckBox x:Name="ChkEnableVgaPatch" IsChecked="{Binding EnableVgaPatch, Mode=TwoWay}"
                              ToolTip="Apply the VGA patch to games as they're added to the list">
                        <TextBlock Text="Apply to newly added games"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding EnableVgaPatchExisting, Mode=TwoWay}" Margin="0 5 0 0"
                              ToolTip="Apply the VGA patch to games already on the SD card">
                        <TextBlock Text="Apply to existing games"/>
                    </CheckBox>
                </StackPanel>
            </GroupBox>

            <!-- Region-Free Patch Card -->
            <GroupBox Margin="0">
                <GroupBox.Header>
                    <TextBlock Text="Region-Free Patch" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel Margin="8">
                    <TextBlock Text="Only needed if booting out-of-region games after &quot;Exit to BIOS&quot; from openMenu" TextWrapping="Wrap"
                               Foreground="Gray" FontSize="11" Margin="0 0 0 10"/>
                    <CheckBox x:Name="ChkEnableRegionPatch" IsChecked="{Binding EnableRegionPatch, Mode=TwoWay}"
                              ToolTip="Apply the region-free patch to games as they're added to the list">
                        <TextBlock Text="Apply to newly added games"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding EnableRegionPatchExisting, Mode=TwoWay}" Margin="0 5 0 0"
                              ToolTip="Apply the region-free patch to games already on the SD card">
                        <TextBlock Text="Apply to existing games"/>
                    </CheckBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Save Button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0">
            <Button Content="Save" Width="80" Padding="15,8" Click="SaveButton_Click" IsDefault="True"
                    ToolTip="Save GDI Shrink, VGA, and Region-Free patch preferences"/>
        </StackPanel>
    </Grid>
</Window>
