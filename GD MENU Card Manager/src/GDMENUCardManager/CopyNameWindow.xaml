<Window x:Class="GDMENUCardManager.CopyNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GDMENUCardManager"
        mc:Ignorable="d"
        Title="Batch Rename" Height="270" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel>
        <GroupBox Header="Rename all games located on" Margin="5">
            <StackPanel>
                <CheckBox IsChecked="{Binding OnCard, Mode=TwoWay}" ToolTip="Include games located on the SD card">SD card</CheckBox>
                <CheckBox IsChecked="{Binding NotOnCard, Mode=TwoWay}" ToolTip="Include games not located on the SD card">Other</CheckBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Copy name from" Margin="5">
            <StackPanel>
                <RadioButton IsChecked="{Binding FolderName, Mode=TwoWay}" ToolTip="Use each game's folder name as the new title">Folder</RadioButton>
                <RadioButton ToolTip="Use each game's disc image file name as the new title">File</RadioButton>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Special parsing" Margin="5">
            <CheckBox IsChecked="{Binding ParseTosec, Mode=TwoWay}" ToolTip="Strip TOSEC-style suffixes (e.g. region, version, dump flags) from the name">Read TOSEC naming</CheckBox>
        </GroupBox>

        <Button Click="Button_Click" IsDefault="True" Margin="5" Padding="20 10"
                ToolTip="Apply the batch rename to the matching games">Ok</Button>

    </StackPanel>
</Window>
