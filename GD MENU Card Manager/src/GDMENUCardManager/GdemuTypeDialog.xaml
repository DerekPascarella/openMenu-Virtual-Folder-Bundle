<Window x:Class="GDMENUCardManager.GdemuTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GDEMU.INI Setup" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message -->
        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">No GDEMU.INI file was found on your SD card. A default configuration file will be created with recommended timing settings for your device.</TextBlock>
            <TextBlock TextWrapping="Wrap">Different GDEMU models require different timing values for reliable operation.</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Unless you purchased your GDEMU directly from its creator, chances are extremely high you own a clone model.</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Please select which type of GDEMU you have.</TextBlock>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="1" Margin="10,15,0,0">
            <RadioButton x:Name="AuthenticRadio" GroupName="GdemuType"
                         ToolTip="Use timing values for an authentic GDEMU purchased directly from its creator">
                <StackPanel>
                    <TextBlock Text="Authentic" FontWeight="SemiBold"/>
                    <TextBlock Text="Purchased directly from its creator" Foreground="Gray"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="CloneRadio" GroupName="GdemuType" IsChecked="True" Margin="0,8,0,0"
                         ToolTip="Use timing values for a clone GDEMU (recommended for most users)">
                <StackPanel>
                    <TextBlock Text="Clone" FontWeight="SemiBold"/>
                    <TextBlock Text="Recommended for most users" Foreground="Gray"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Click="OkButton_Click" Width="90" Padding="15,8" IsDefault="True"
                    ToolTip="Create GDEMU.INI with timing values for the selected model"/>
        </StackPanel>
    </Grid>
</Window>
