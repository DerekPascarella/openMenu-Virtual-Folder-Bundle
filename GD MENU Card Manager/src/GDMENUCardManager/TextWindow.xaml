<Window x:Class="GDMENUCardManager.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GDMENUCardManager"
        mc:Ignorable="d"
        Title="TextWindow" Height="350" Width="600" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="OK" Click="OkButton_Click" IsDefault="True" Width="80" Padding="15,8" HorizontalAlignment="Right" Margin="0,10,10,10"/>
        <TextBox IsReadOnly="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Text="{Binding Text, Mode=OneTime}"/>
    </DockPanel>
</Window>
