<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GDMENUCardManager.Converter"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="620"
        x:Class="GDMENUCardManager.FolderToolsWindow"
        Title="Folder Tools" Width="520" Height="620" MinWidth="480" MinHeight="450"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <conv:ArtworkButtonLabelConverter x:Key="ArtworkButtonLabel"/>
    <conv:ArtworkButtonFontWeightConverter x:Key="ArtworkButtonFontWeight"/>
    <conv:DropTargetBrushConverter x:Key="DropTargetBrush"/>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
    </Style>
  </Window.Styles>
  <Grid Margin="10">
    <TabControl>
      <TabControl.Styles>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
          <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="12"/>
        </Style>
      </TabControl.Styles>
      <!-- Folder Artwork Tab -->
      <TabItem Header="Folder Artwork">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock FontWeight="Bold" TextWrapping="Wrap"
                       Text="Assign artwork to folders shown in openMenu's Folders view mode"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Artwork changes aren't written to DAT files until clicking Save Changes in the main window."/>
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="6,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <DockPanel Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Line StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="#A8A8A8" StrokeThickness="1"
                              StrokeDashArray="1,3" VerticalAlignment="Center" Margin="6,2,0,0"/>
                      </DockPanel>
                      <Button Grid.Column="1" MinWidth="70" Padding="5,2" Click="AssignManage_Click" CommandParameter="{Binding}"
                              Content="{Binding HasArt, Converter={StaticResource ArtworkButtonLabel}}"
                              FontWeight="{Binding HasArt, Converter={StaticResource ArtworkButtonFontWeight}}"
                              ToolTip.Tip="{Binding HasArt, Converter={StaticResource ArtworkButtonLabel}, ConverterParameter=tooltip}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,12,0,5"
                     IsVisible="{Binding HasOrphans}"
                     Text="Unassigned artwork (folders that no longer exist)"/>

          <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" MaxHeight="140"
                  IsVisible="{Binding HasOrphans}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Orphans}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="6,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <DockPanel Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Line StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="#A8A8A8" StrokeThickness="1"
                              StrokeDashArray="1,3" VerticalAlignment="Center" Margin="6,2,0,0"/>
                      </DockPanel>
                      <Button Grid.Column="1" Padding="5,2" Margin="0,0,5,0" Content="View" Click="OrphanView_Click" CommandParameter="{Binding}"
                              ToolTip.Tip="View the stored artwork"/>
                      <Button Grid.Column="2" Padding="5,2" Margin="0,0,5,0" Content="Re-assign..." Click="OrphanReassign_Click" CommandParameter="{Binding}"
                              ToolTip.Tip="Move this artwork onto a current folder"/>
                      <Button Grid.Column="3" Padding="5,2" Content="Delete" Click="OrphanDelete_Click" CommandParameter="{Binding}"
                              ToolTip.Tip="Remove this artwork from FOLDRART.DAT"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- Batch Folder Move/Rename Tab -->
      <TabItem Header="Batch Folder Move/Rename" IsEnabled="{Binding CanBatchRename}">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontWeight="Bold" TextWrapping="Wrap"
                       Text="Perform batch folder move and rename operations"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Double-click to rename folders. Drag folders to reparent them. Changes apply when you click Apply Changes."/>
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <TreeView x:Name="FolderTreeView" ItemsSource="{Binding RootNodes}" DragDrop.AllowDrop="True">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <Border Background="{Binding IsDropTarget, Converter={StaticResource DropTargetBrush}}"
                          Padding="2" CornerRadius="2">
                    <Grid>
                      <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding !IsEditing}" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding Name, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                               MinWidth="120"
                               KeyDown="EditTextBox_KeyDown"
                               LostFocus="EditTextBox_LostFocus"
                               AttachedToVisualTree="EditTextBox_AttachedToVisualTree"/>
                    </Grid>
                  </Border>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>

          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button HorizontalAlignment="Left" Content="Undo Last Change" Padding="15,8"
                    Click="UndoButton_Click" IsEnabled="{Binding CanUndo}"
                    ToolTip.Tip="Revert the most recent rename or move"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Apply Changes" Padding="15,8" Margin="0,0,10,0" Click="ApplyButton_Click" IsDefault="True"
                      ToolTip.Tip="Apply all folder renames and moves"/>
              <Button Content="Cancel" Width="80" Padding="15,8" Click="CancelButton_Click"
                      ToolTip.Tip="Discard all pending folder changes and close"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
