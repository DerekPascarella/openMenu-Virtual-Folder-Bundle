<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="200"
        x:Class="GDMENUCardManager.GdemuTypeDialog"
        Title="GDEMU.INI Setup" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" CanResize="False" CanMinimize="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message -->
        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">No GDEMU.INI file was found on your SD card. A default configuration file will be created with recommended timing settings for your device.</TextBlock>
            <TextBlock TextWrapping="Wrap">Different GDEMU models require different timing values for reliable operation.</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Unless you purchased your GDEMU directly from its creator, chances are extremely high you own a clone model.</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Please select which type of GDEMU you have.</TextBlock>
        </StackPanel>

        <!-- Options. the radio holds only the label so the glyph lines up with it,
             the Avalonia template centers the glyph against the whole content and
             would leave it floating between the two lines otherwise -->
        <StackPanel Grid.Row="1" Margin="10,15,0,0">
            <RadioButton x:Name="AuthenticRadio" GroupName="GdemuType"
                         ToolTip.Tip="Use timing values for an authentic GDEMU purchased directly from its creator">
                <TextBlock Text="Authentic" FontWeight="SemiBold"/>
            </RadioButton>
            <TextBlock Text="Purchased directly from its creator" Foreground="Gray" Margin="24,0,0,0"/>
            <RadioButton x:Name="CloneRadio" GroupName="GdemuType" IsChecked="True" Margin="0,8,0,0"
                         ToolTip.Tip="Use timing values for a clone GDEMU (recommended for most users)">
                <TextBlock Text="Clone" FontWeight="SemiBold"/>
            </RadioButton>
            <TextBlock Text="Recommended for most users" Foreground="Gray" Margin="24,0,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Click="OkButton_Click" Width="90" Padding="15,8" IsDefault="True"
                    ToolTip.Tip="Create GDEMU.INI with timing values for the selected model"/>
        </StackPanel>
    </Grid>
</Window>
