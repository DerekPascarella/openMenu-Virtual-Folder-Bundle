<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GDMENUCardManager"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
        x:Class="GDMENUCardManager.AssignAltFoldersWindow"
        Title="Assign Additional Folder Paths"
        SizeToContent="Height" Width="420" MinHeight="160"
        CanResize="False" CanMinimize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="15">
    <TextBlock x:Name="HeaderLabel" Margin="0 0 0 15" FontWeight="Bold"/>

    <ItemsControl x:Name="AltFoldersList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0 0 0 8">
            <TextBlock Margin="0 0 0 3"
                       Text="{Binding Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="X" Width="26" Height="26"
                      Margin="5 0 0 0" Click="RemoveButton_Click" IsTabStop="False"
                      ToolTip.Tip="Remove this folder path"/>
              <ComboBox ItemsSource="{Binding $parent[Window].KnownFolders}"
                        Text="{Binding FolderPath, Mode=TwoWay}"
                        IsEditable="True" MaxDropDownHeight="200"
                        HorizontalAlignment="Stretch" PlaceholderText="e.g., Games\Action\US"
                        local:EditableComboBehavior.IsEnabled="True"
                        GotFocus="FolderPath_GotFocus" KeyDown="FolderPath_KeyDown"
                        LostFocus="FolderPath_LostFocus"/>
            </DockPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button x:Name="AddButton" Content="+ Add Folder Path" Click="AddButton_Click"
            HorizontalAlignment="Left" Margin="0 0 0 0" Padding="15,8"
            ToolTip.Tip="Add another folder path for this game"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
      <Button Content="OK" Click="OkButton_Click" Width="80" Padding="15,8" Margin="0 0 10 0"
              ToolTip.Tip="Save the additional folder paths for this game"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsCancel="True" Width="80" Padding="15,8"
              ToolTip.Tip="Close without saving changes"/>
    </StackPanel>
  </StackPanel>
</Window>
