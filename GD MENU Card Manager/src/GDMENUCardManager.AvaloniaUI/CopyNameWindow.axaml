<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="400"
        x:Class="GDMENUCardManager.CopyNameWindow"
        Title="Batch Rename" Height="270" Width="350" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel>
    <HeaderedContentControl Header="Rename all games located on" Margin="5">
      <StackPanel>
        <CheckBox IsChecked="{Binding OnCard}" ToolTip.Tip="Include games located on the SD card">SD card</CheckBox>
        <CheckBox IsChecked="{Binding NotOnCard}" ToolTip.Tip="Include games not located on the SD card">Other</CheckBox>
      </StackPanel>
    </HeaderedContentControl>

    <HeaderedContentControl Header="Copy name from" Margin="5">
      <StackPanel>
        <RadioButton IsChecked="{Binding FolderName}" ToolTip.Tip="Use each game's folder name as the new title">Folder</RadioButton>
        <RadioButton ToolTip.Tip="Use each game's disc image file name as the new title">File</RadioButton>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Header="Special parsing" Margin="5">
      <CheckBox IsChecked="{Binding ParseTosec}" ToolTip.Tip="Strip TOSEC-style suffixes (e.g. region, version, dump flags) from the name">Read TOSEC naming</CheckBox>
    </HeaderedContentControl>

    <Button Click="Button_Click" IsDefault="True" Margin="5" Padding="20 10"
            ToolTip.Tip="Apply the batch rename to the matching games">Ok</Button>

  </StackPanel>

</Window>
