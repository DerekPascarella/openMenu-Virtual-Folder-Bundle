<?xml version="1.0" encoding="utf-8"?>
<!-- All packages for this test build come from nuget.org.
     The old AvaloniaCI myget feed is dead and was removed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
