<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="400"
        x:Class="GDMENUCardManager.ArtworkWindow"
        Title="{Binding WindowTitle}" Width="420" SizeToContent="Height" CanResize="False" CanMinimize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Serial ID -->
    <TextBlock Grid.Row="0" Text="{Binding Serial}" FontWeight="Bold" Foreground="Black"
               HorizontalAlignment="Center" Margin="0,0,0,10"/>

<!-- Preview -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Click="NavigatePrev_Click"
              IsEnabled="{Binding CanNavigatePrev}"
              ToolTip.Tip="Show previous game's artwork"
              VerticalAlignment="Center" Width="30" Height="40" Padding="0" Margin="0,0,40,0">
        <Path Data="M 10,0 L 0,8 L 10,16" Stroke="Black" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>

      <Border BorderBrush="Gray" BorderThickness="1"
              Width="260" Height="260" VerticalAlignment="Center" Margin="0,0,40,0">
        <Grid>
          <TextBlock Text="No artwork assigned" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasPreviewImage}"/>
          <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                 IsVisible="{Binding HasPreviewImage}"/>
        </Grid>
      </Border>

      <Button Click="NavigateNext_Click"
              IsEnabled="{Binding CanNavigateNext}"
              ToolTip.Tip="Show next game's artwork"
              VerticalAlignment="Center" Width="30" Height="40" Padding="0">
        <Path Data="M 0,0 L 10,8 L 0,16" Stroke="Black" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
    </StackPanel>

    <!-- Info Label -->
    <TextBlock Grid.Row="2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="Black"
               Text="Artwork changes aren't written to DAT files until clicking Save Changes in the main window."/>

    <!-- Buttons -->
    <StackPanel x:Name="ButtonRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button Content="Browse for Image" Click="BrowseImage_Click" Margin="0,0,10,0" Padding="15,8"
              ToolTip.Tip="Choose a PNG, JPG, or BMP file to use as artwork for this game"/>
      <Button Content="Import From Disc" Click="ImportFromDisc_Click" Margin="0,0,10,0" Padding="15,8"
              IsEnabled="{Binding CanImportFromDisc}"
              ToolTip.ShowOnDisabled="True"
              ToolTip.Tip="{Binding ImportFromDiscTooltip}"/>
      <Button Content="Delete Entry" Click="DeleteEntry_Click" Margin="0,0,10,0" Padding="15,8"
              IsEnabled="{Binding CanDelete}"
              ToolTip.Tip="Remove this game's artwork and metadata from the DATs"/>
      <Button Content="Save" Click="Apply_Click" Padding="15,8"
              IsEnabled="{Binding HasUnsavedChanges}"
              ToolTip.Tip="Stage artwork changes for this game (DAT files aren't written until you click Save Changes in the main window)"/>
    </StackPanel>
  </Grid>
</Window>
