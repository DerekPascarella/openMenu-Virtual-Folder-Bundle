+++ b/kernel/arch/dreamcast/include/dc/sd.h
@@ -73,9 +73,10 @@ uint8 sd_crc7(const uint8 *data, int size, uint8 crc);
     time.
 
     \retval 0               On success.
-    \retval -1              On failure. This could indicate any number of
-                            problems, but probably means that no SD card was
-                            detected.
+    \retval -1              No card answered the reset command, which usually
+                            means no card is inserted.
+    \retval -2              A card answered the reset command, but
+                            initialization failed.
 */
 int sd_init(void);
 
