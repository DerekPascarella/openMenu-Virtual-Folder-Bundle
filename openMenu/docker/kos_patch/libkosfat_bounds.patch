index b34eece..fd4f75b 100644
--- a/addons/libkosfat/bpb.c
+++ b/addons/libkosfat/bpb.c
@@ -105,6 +105,11 @@ static int fat_parse_boot(fat_bootblock_t *bb, fat_superblock_t *sb) {
     /* Do work needed to determine what type of filesystem we have... */
     rds = bb->bpb.root_dir_entries[0] | (bb->bpb.root_dir_entries[1] << 8);
     bps = bb->bpb.bytes_per_sector[0] | (bb->bpb.bytes_per_sector[1] << 8);
+
+    /* Both are divisors below. They're zero in an exFAT boot sector. */
+    if(!bps || !bb->bpb.sectors_per_cluster)
+        return -EINVAL;
+
     rds = ((rds << 5) + (bps - 1)) / bps;
 
     fsz = bb->bpb.fat_size[0] | (bb->bpb.fat_size[1] << 8);
